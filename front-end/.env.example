# Copy to front-end/.env for local development.
# Expo Go usually discovers the laptop IP automatically — leave this unset unless needed.

# Force a backend URL (required for standalone Android preview APK builds).
# Example on phone hotspot: http://192.168.43.1:8000/api/v1
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1

EXPO_PUBLIC_USE_API=1
