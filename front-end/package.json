{
  "name": "my-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/ui": "~58.0.27",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:go": "expo start -c",
    "start:tunnel": "expo start -c --tunnel ngrok",
    "start:tunnel:expo": "expo start -c --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "eas build -p android --profile preview",
    "build:apk:local": "eas build -p android --profile preview --local",
    "lint": "expo lint",
    "test:api": "node --test --experimental-strip-types src/services/__tests__/apiUrl.test.ts",
    "test:scan": "node --test --experimental-strip-types src/services/__tests__/scanApi.test.ts",
    "test:reminders": "node --test --experimental-strip-types src/utils/__tests__/reminderDates.test.mjs",
    "test": "npm run test:api && npm run test:scan && npm run test:reminders",
    "postinstall": "cd .. && git config core.hooksPath .githooks"
  },
  "private": true
}
